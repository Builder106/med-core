{
  "name": "@builder106/medcore",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,tunnel -c cyan,magenta,green \"npm:dev:web\" \"npm:dev:api\" \"npm:tunnel\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "tunnel": "bash scripts/tunnel.sh",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm test && npm --prefix server test",
    "e2e": "bddgen test --config e2e/playwright.config.ts && playwright test --config=e2e/playwright.config.ts",
    "e2e:demo": "DEMO=1 bddgen test --config e2e/playwright.demo.config.ts && DEMO=1 playwright test --config=e2e/playwright.demo.config.ts",
    "e2e:demo:gif": "node scripts/mp4-to-gif.mjs",
    "test:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "verify:a11y-matrix": "node --experimental-strip-types scripts/verify-a11y-matrix.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "clsx": "2.1.1",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "1.64.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-is": "^19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
