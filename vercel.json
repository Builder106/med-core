{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --legacy-peer-deps",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "*": false,
      "**": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.yinkavaughan.me/api/:path*"
    }
  ]
}